{
  "name": "cloudcore-ai",
  "version": "2.0.0",
  "private": true,
  "description": "CloudCore AI workspace and self-hosted Meetings AI control plane",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --watch --env-file=.env build/server.js",
    "start": "node --env-file=.env build/server.js",
    "worker": "node --env-file=.env build/worker.js",
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check dist/app.js && npm run build && node scripts/verify.cjs && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "bullmq": "5.81.5",
    "connect-redis": "8.0.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.0",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "openid-client": "5.7.1",
    "pg": "8.16.3",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.2",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2"
  }
}